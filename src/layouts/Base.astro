---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { categorieen } from '../data/categorieen';
import { categorieStijl, catStyle } from '../data/categorie-stijl';

interface Props {
  /** Paginatitel zonder sitenaam. Leeg = homepage-titel. */
  title?: string;
  description?: string;
  /** 'article' voor artikelpagina's (OG-type) */
  type?: 'website' | 'article';
  /** Pad t.o.v. public/ (zonder leading slash), bijv. 'og/mijn-artikel.png' */
  image?: string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  /** Categorie-slug om in de hoofdnavigatie te markeren (bijv. op artikelpagina's) */
  activeCategory?: string;
}

const SITE_NAME = 'SmartHomeHuurders';
const {
  title,
  description = 'Smart home producten voor huurders in Nederland en België: slim wonen zonder boren, zonder verbouwen en mee te nemen bij verhuizing.',
  type = 'website',
  image = 'og-default.png',
  imageAlt = 'SmartHomeHuurders — slim wonen zonder boren',
  publishedTime,
  modifiedTime,
  noindex = false,
  activeCategory,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} — Smart home voor huurders (NL/BE)`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${base}${image.replace(/^\//, '')}`, Astro.site);
const path = Astro.url.pathname;

const navCats = categorieen.map((c) => {
  const href = `${base}categorie/${c.slug}/`;
  return {
    slug: c.slug,
    href,
    label: categorieStijl[c.slug]?.kort ?? c.label,
    active: path.startsWith(href) || activeCategory === c.slug,
  };
});
const artikelenActive = path === `${base}artikelen/`;
const jaar = new Date().getFullYear();
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>(function(h){h.classList.add('js');try{['eco','land'].forEach(function(k){var v=localStorage.getItem('shh-'+k);if(v)h.setAttribute('data-'+k,v)})}catch(e){}})(document.documentElement)</script>
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <link rel="sitemap" href={`${base}sitemap-index.xml`} />

  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <meta name="theme-color" content="#0f766e" />

  <!-- Open Graph / social sharing -->
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title ?? fullTitle} />
  <meta property="og:description" content={description} />
  {!noindex && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title ?? fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#inhoud">Naar inhoud</a>

  <header class="site-header" id="site-header">
    <div class="container header-inner">
      <a class="brand" href={base} aria-label={`${SITE_NAME} — home`}>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="15" fill="#0f766e" />
          <path d="M15 31 32 17l17 14v17a3 3 0 0 1-3 3H18a3 3 0 0 1-3-3Z" fill="none" stroke="#fff" stroke-width="4.5" stroke-linejoin="round" />
          <path d="M25.5 37.5a9 9 0 0 1 13 0" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" />
          <circle cx="32" cy="43.5" r="3.2" fill="#fbbf24" />
        </svg>
        <span>SmartHome<b>Huurders</b></span>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        <Icon name="menu" class="icon-open" />
        <Icon name="close" class="icon-close" />
        <span class="nav-toggle-label">Menu</span>
      </button>

      <nav class="main-nav" id="main-nav" aria-label="Hoofdmenu">
        <ul>
          {navCats.map((item) => (
            <li>
              <a class="has-cat" style={catStyle(item.slug)} href={item.href} aria-current={item.active ? 'page' : undefined}>
                <span class="nav-icon"><Icon name={item.slug} /></span>{item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`${base}artikelen/`} aria-current={artikelenActive ? 'page' : undefined}>
              <span class="nav-icon"><Icon name="article" /></span>Alle artikelen
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="inhoud">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="color-bar" aria-hidden="true"></div>
    <div class="container footer-grid">
      <div class="footer-about">
        <a class="brand" href={base}>
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="15" fill="#0f766e" />
            <path d="M15 31 32 17l17 14v17a3 3 0 0 1-3 3H18a3 3 0 0 1-3-3Z" fill="none" stroke="#fff" stroke-width="4.5" stroke-linejoin="round" />
            <path d="M25.5 37.5a9 9 0 0 1 13 0" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" />
            <circle cx="32" cy="43.5" r="3.2" fill="#fbbf24" />
          </svg>
          <span>SmartHome<b>Huurders</b></span>
        </a>
        <p>Praktisch advies over smart home producten die je als huurder zonder boren of verbouwen installeert — en bij verhuizing gewoon meeneemt.</p>
      </div>
      <nav aria-label="Categorieën">
        <h2>Categorieën</h2>
        <ul>
          {categorieen.map((c) => (
            <li>
              <a class="footer-link has-cat" style={catStyle(c.slug)} href={`${base}categorie/${c.slug}/`}>
                <Icon name={c.slug} />{c.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Informatie">
        <h2>Informatie</h2>
        <ul>
          <li><a class="footer-link" href={`${base}artikelen/`}><Icon name="article" />Alle artikelen</a></li>
          <li><a class="footer-link" href={`${base}categorie/`}><Icon name="grid" />Alle categorieën</a></li>
          <li><a class="footer-link" href={`${base}keuzehulp/`}><Icon name="compare" />Keuzehulp</a></li>
          <li><a class="footer-link" href={`${base}over-ons/`}><Icon name="users" />Over ons &amp; werkwijze</a></li>
          <li><a class="footer-link" href={`${base}disclosure/`}><Icon name="info" />Affiliate disclosure</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer-bottom"><div class="container">
      <p>Dit is een affiliate website. Bepaalde links kunnen een commissie opleveren, zonder extra kosten voor jou. <a href={`${base}disclosure/`}>Lees onze disclosure</a>.</p>
      <p>© {jaar} {SITE_NAME}</p>
    </div></div>
  </footer>

  <script is:inline>
    (function () {
      var header = document.getElementById('site-header');
      var btn = header && header.querySelector('.nav-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var open = header.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
        btn.querySelector('.nav-toggle-label').textContent = open ? 'Sluiten' : 'Menu';
      });
    })();
  </script>
</body>
</html>
