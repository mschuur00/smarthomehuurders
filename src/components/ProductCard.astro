---
import Icon from './Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { ecoLijst, formatDatum, formatPrijs, huurderBadges, kosten3Jaar, kostenRegel, lijst, scoreHtml, specs, winkels, huurderScore } from '../lib/producten.mjs';
import { filtersPerCategorie, prijsKlasse, scoreKlasse } from '../data/filters.mjs';
import { catStyle } from '../data/categorie-stijl';

interface Props {
  product: CollectionEntry<'producten'>;
}
const { product } = Astro.props;
const d = product.data;
const base = import.meta.env.BASE_URL;
const groepen = filtersPerCategorie[d.categorie]?.groepen ?? [];
const score = huurderScore(d).score;
const kosten = kosten3Jaar(d);

const dataAttrs: Record<string, string> = {
  'data-id': product.id,
  'data-prijs': String(d.prijs.vanaf),
  'data-kosten': String(kosten.totaal),
  'data-score': String(score),
  'data-volgorde': String(d.volgorde),
  'data-f-prijs': prijsKlasse(d.prijs.vanaf),
  'data-f-score': scoreKlasse(score),
};
for (const g of groepen) dataAttrs[`data-f-${g.key.toLowerCase()}`] = lijst(d.kenmerken[g.key]).join(' ');

const badges = huurderBadges(d).slice(0, 4);
const ws = winkels(d);
---
<article class="product-card has-cat" style={catStyle(d.categorie)} id={`product-${product.id}`} {...dataAttrs}>
  <div class="pc-top">
    {d.label ? <span class="pc-label"><Icon name="star" />{d.label}</span> : <span class="pc-brand">{d.merk}</span>}
    <Fragment set:html={scoreHtml(d)} />
  </div>

  <h3 class="pc-name"><a href={`${base}product/${product.id}/`}>{d.naam}</a></h3>

  <p class="pc-price">
    <span class="pc-price-main"><small>vanaf</small> <strong>{formatPrijs(d.prijs.vanaf)}</strong></span>
    <span class="pc-price-note">{d.prijs.tekst}</span>
    <span class="pc-kosten">{kostenRegel(d)}</span>
  </p>

  <ul class="huurderproof pc-badges" aria-label="Huurder-check">
    {badges.map((h) => <li class={h.status}>{h.tekst}</li>)}
  </ul>
  <span class="eco-fit" data-eco={ecoLijst(d).join(' ')}></span>

  <p class="pc-summary">{d.samenvatting}</p>

  <dl class="pc-specs">
    {specs(d).map((s) => (
      <div class:list={['pc-spec', { 'is-positive': s.positief }]}>
        <dt>{s.label}</dt>
        <dd>{s.waarden.join(', ')}</dd>
      </div>
    ))}
  </dl>

  <details class="pc-details">
    <summary>Voor- en nadelen <Icon name="chevron-down" class="pc-chevron" /></summary>
    <div class="pros-cons">
      <div class="pros"><strong>Pluspunten</strong><ul>{d.voordelen.map((v) => <li>{v}</li>)}</ul></div>
      <div class="cons"><strong>Minpunten</strong><ul>{d.nadelen.map((v) => <li>{v}</li>)}</ul></div>
    </div>
  </details>

  <div class="pc-actions">
    {ws.map((w, i) => (
      <a class:list={['cta', { 'cta--secondary': i > 0 }]} href={w.url} rel={w.rel} target="_blank" data-land={w.landen.join(' ')}>
        {i === 0 ? `Bekijk bij ${w.naam}` : w.naam}
      </a>
    ))}
  </div>

  <div class="pc-foot">
    <label class="pc-compare"><input type="checkbox" data-compare value={product.id} /> Vergelijk</label>
    <a href={`${base}product/${product.id}/`}>Details <Icon name="arrow" /></a>
  </div>
  <p class="pc-meta">{ws.some((w) => w.affiliate) ? 'Affiliate link · ' : ''}Prijs gecontroleerd {formatDatum(d.prijs.gecontroleerd)}</p>
</article>
