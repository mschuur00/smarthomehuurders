---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { formatDatum, leestijd, sorteerOpDatum, vindCategorie } from '../../utils/artikel';

export async function getStaticPaths() {
  const artikelen = await getCollection('artikelen');
  return artikelen.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
const { title, description, pubDate, category, affiliateDisclosure } = entry.data;
const cat = vindCategorie(category);

const gerelateerd = sorteerOpDatum(
  (await getCollection('artikelen')).filter((a) => a.data.category === category && a.slug !== entry.slug)
).slice(0, 3);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const abs = (p: string) => new URL(p, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    inLanguage: 'nl-NL',
    mainEntityOfPage: pageUrl,
    image: abs(`${base}og-default.png`),
    publisher: { '@type': 'Organization', name: 'SmartHomeHuurders', url: abs(base) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs(base) },
      ...(cat ? [{ '@type': 'ListItem', position: 2, name: cat.label, item: abs(`${base}categorie/${cat.slug}/`) }] : []),
      { '@type': 'ListItem', position: cat ? 3 : 2, name: title, item: pageUrl },
    ],
  },
];
---
<Base title={title} description={description} type="article" publishedTime={pubDate} activeCategory={category}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="article">
    <header class="article-header">
      <nav class="breadcrumbs" aria-label="Kruimelpad">
        <ol>
          <li><a href={base}>Home</a></li>
          {cat && <li><a href={`${base}categorie/${cat.slug}/`}>{cat.label}</a></li>}
          <li><span aria-current="page">{title}</span></li>
        </ol>
      </nav>
      {cat && <a class="tag" href={`${base}categorie/${cat.slug}/`}>{cat.label}</a>}
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="article-meta">
        <span>Gepubliceerd <time datetime={pubDate.toISOString()}>{formatDatum(pubDate)}</time></span>
        <span>{leestijd(entry.body)} min leestijd</span>
      </div>
    </header>

    {affiliateDisclosure && (
      <aside class="notice" aria-label="Affiliate melding">
        <Icon name="info" />
        <p>
          <strong>Dit artikel bevat affiliate links.</strong> Koop je via zo'n link, dan ontvangen wij mogelijk een kleine commissie — zonder extra kosten voor jou.
          <a href={`${base}disclosure/`}>Meer uitleg</a>.
        </p>
      </aside>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="article-footer">
      {cat && (
        <a class="btn btn-ghost" href={`${base}categorie/${cat.slug}/`}>
          Meer over {cat.label.toLowerCase()} <Icon name="arrow" />
        </a>
      )}
    </footer>
  </article>

  {gerelateerd.length > 0 && (
    <section class="container related" aria-labelledby="gerelateerd">
      <div class="section-head"><h2 id="gerelateerd">Lees ook</h2></div>
      <div class="card-grid card-grid--wide">
        {gerelateerd.map((a) => <ArticleCard artikel={a} toonCategorie={false} />)}
      </div>
    </section>
  )}
</Base>
