---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import Faq from '../components/Faq.astro';
import { categorieen } from '../data/categorieen';
import { catStyle } from '../data/categorie-stijl';
import { faq } from '../data/faq';
import { categorieTelling, getArtikelen, sorteerOpDatum } from '../utils/artikel';

const alleArtikelen = await getArtikelen();
const artikelen = sorteerOpDatum(alleArtikelen).slice(0, 6);
const base = import.meta.env.BASE_URL;
const telling = await categorieTelling();

const usps = [
  { icon: 'no-drill', kleur: '#0f766e', titel: 'Zonder boren', tekst: 'Inpluggen, indraaien of plakken' },
  { icon: 'box', kleur: '#2563eb', titel: 'Mee bij verhuizing', tekst: 'Alles gaat met je mee' },
  { icon: 'no-tool', kleur: '#e11d48', titel: 'Geen installateur', tekst: 'Zelf te installeren' },
  { icon: 'bag', kleur: '#d97706', titel: 'Winkels in NL & BE', tekst: 'Gewoon online te koop' },
];

const stappen = [
  { icon: 'grid', kleur: '#0f766e', titel: 'Kies wat je slim wilt maken', tekst: 'Verlichting, sloten, verwarming, stekkers of camera\'s: begin waar jij het meeste aan hebt.' },
  { icon: 'compare', kleur: '#2563eb', titel: 'Vergelijk huurder-proof opties', tekst: 'Per product zie je of het zonder boren kan, of je het meeneemt en wat de nadelen zijn.' },
  { icon: 'cart', kleur: '#c2410c', titel: 'Koop bij een bekende winkel', tekst: 'Via onze links naar Nederlandse en Belgische webwinkels. Dat kost jou niets extra; wij krijgen soms een kleine commissie.' },
];
---
<Base>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <span class="eyebrow"><Icon name="home" /> Voor huurders in Nederland &amp; België</span>
        <h1>Slim wonen zonder boren of gedoe met de verhuurder</h1>
        <p class="hero-lead">
          Wij zoeken uit welke slimme lampen, sloten, thermostaten, stekkers en camera's écht geschikt zijn voor een huurwoning — zodat jij niet hoeft te verbouwen.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={`${base}categorie/`}>
            Bekijk categorieën <Icon name="arrow" />
          </a>
          <a class="btn btn-ghost" href={`${base}over-ons/`}>
            <Icon name="shield" /> Hoe wij selecteren
          </a>
        </div>
      </div>
      <div class="hero-art">
        <HeroIllustration />
      </div>
    </div>
  </section>

  <section class="usp-strip" aria-label="Waar wij op letten">
    <ul class="container usp-list">
      {usps.map((u) => (
        <li class="usp has-cat" style={`--cat: ${u.kleur}`}>
          <span class="usp-icon"><Icon name={u.icon} /></span>
          <span><b>{u.titel}</b><small>{u.tekst}</small></span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section container" aria-labelledby="cat-titel">
    <div class="section-head">
      <div>
        <span class="eyebrow eyebrow--amber"><Icon name="grid" /> Categorieën</span>
        <h2 id="cat-titel">Kies een categorie</h2>
      </div>
      <p>Van verlichting tot beveiliging, allemaal huurwoning-proof.</p>
    </div>
    <div class="card-grid card-grid--cats">
      {categorieen.map((c) => {
        return (
          <article class="card card--cat has-cat" style={catStyle(c.slug)}>
            <div class="icon-bubble"><Icon name={c.slug} /></div>
            <h3><a href={`${base}categorie/${c.slug}/`}>{c.label}</a></h3>
            <p>{c.omschrijving}</p>
            <div class="card-foot">
              <span class="count-pill">{telling[c.slug]}</span>
              <span class="card-more" aria-hidden="true">Bekijk →</span>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="steps-section" aria-labelledby="stappen-titel">
    <div class="container section">
      <div class="section-head section-head--center">
        <span class="eyebrow eyebrow--blue"><Icon name="list" /> Zo werkt het</span>
        <h2 id="stappen-titel">In drie stappen een slimmer huurhuis</h2>
      </div>
      <ol class="steps">
        {stappen.map((s, i) => (
          <li class="step has-cat" style={`--cat: ${s.kleur}`}>
            <span class="step-icon"><Icon name={s.icon} /><span class="step-num">{i + 1}</span></span>
            <h3>{s.titel}</h3>
            <p>{s.tekst}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section container" aria-labelledby="art-titel">
    <div class="section-head">
      <div>
        <span class="eyebrow eyebrow--rose"><Icon name="article" /> Nieuw</span>
        <h2 id="art-titel">Laatste artikelen</h2>
      </div>
      {alleArtikelen.length > artikelen.length && <a href={`${base}artikelen/`}>Alle artikelen →</a>}
    </div>
    {artikelen.length === 0 ? (
      <div class="empty-state">
        <span class="empty-icon"><Icon name="article" /></span>
        <h3>De eerste koopgidsen zijn in de maak</h3>
        <p>We zetten per categorie de beste huurder-proof producten op een rij. Kijk intussen welke categorieën eraan komen.</p>
        <a class="btn btn-ghost" href={`${base}categorie/`}>Bekijk categorieën</a>
      </div>
    ) : (
      <div class="card-grid card-grid--wide">
        {artikelen.map((a) => <ArticleCard artikel={a} />)}
      </div>
    )}
  </section>

  <Faq items={faq} />
</Base>
