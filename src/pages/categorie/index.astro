---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { categorieen } from '../../data/categorieen';
import { catStyle } from '../../data/categorie-stijl';
import { categorieSamenvatting } from '../../utils/artikel';
import { formatPrijs } from '../../lib/producten.mjs';

const samenvatting = await categorieSamenvatting();
const base = import.meta.env.BASE_URL;
---
<Base title="Categorieën" description="Alle smart home categorieën voor huurders: verlichting, sloten, thermostaten, stekkers en camera's zonder boren.">
  <div class="page-head page-head--band">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Kruimelpad">
        <ol>
          <li><a href={base}><Icon name="home" /><span class="sr-only">Home</span></a></li>
          <li><span aria-current="page">Categorieën</span></li>
        </ol>
      </nav>
      <h1>Categorieën</h1>
      <p class="lead">Kies waar je mee wilt beginnen. Elke categorie bevat alleen producten die je zonder verbouwing installeert.</p>
    </div>
  </div>

  <div class="container">
    <div class="card-grid card-grid--cats">
      {categorieen.map((c) => {
        return (
          <article class="card card--cat has-cat" style={catStyle(c.slug)}>
            <div class="icon-bubble"><Icon name={c.slug} /></div>
            <h3><a href={`${base}categorie/${c.slug}/`}>{c.label}</a></h3>
            <p>{c.omschrijving}</p>
            <div class="card-foot">
              <span class="count-pill">{samenvatting[c.slug].tekst}</span>
              {samenvatting[c.slug].vanaf !== undefined && <span class="count-pill count-pill--prijs">vanaf {formatPrijs(samenvatting[c.slug].vanaf!)}</span>}
              <span class="card-more" aria-hidden="true">Bekijk →</span>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Base>
