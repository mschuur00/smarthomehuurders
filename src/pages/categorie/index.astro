---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { categorieen } from '../../data/categorieen';

const artikelen = await getCollection('artikelen');
const base = import.meta.env.BASE_URL;
---
<Base title="Categorieën">
  <h1>Categorieën</h1>
  <ul>
    {categorieen.map((c) => {
      const count = artikelen.filter((a) => a.data.category === c.slug).length;
      return (
        <li>
          <a href={`${base}categorie/${c.slug}/`}>{c.label}</a>
          <p>{c.omschrijving}</p>
          <small>{count} artikel{count === 1 ? '' : 'en'}</small>
        </li>
      );
    })}
  </ul>
</Base>
