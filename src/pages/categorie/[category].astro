---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { categorieen } from '../../data/categorieen';
import { sorteerOpDatum } from '../../utils/artikel';

export async function getStaticPaths() {
  return categorieen.map((c) => ({
    params: { category: c.slug },
    props: { categorie: c },
  }));
}

const { categorie } = Astro.props;
const alleArtikelen = await getCollection('artikelen');
const artikelen = sorteerOpDatum(alleArtikelen.filter((a) => a.data.category === categorie.slug));
const andere = categorieen.filter((c) => c.slug !== categorie.slug);
const base = import.meta.env.BASE_URL;
---
<Base title={categorie.label} description={categorie.omschrijving}>
  <div class="page-head page-head--band">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Kruimelpad">
        <ol>
          <li><a href={base}>Home</a></li>
          <li><a href={`${base}categorie/`}>Categorieën</a></li>
          <li><span aria-current="page">{categorie.label}</span></li>
        </ol>
      </nav>
      <div class="page-head-row">
        <div class="icon-bubble"><Icon name={categorie.slug} /></div>
        <div>
          <h1>{categorie.label}</h1>
          <p class="lead">{categorie.omschrijving}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    {artikelen.length === 0 ? (
      <div class="empty-state">
        <h2>Binnenkort artikelen in deze categorie</h2>
        <p>We zijn de beste {categorie.label.toLowerCase()} voor huurders aan het uitzoeken. Kijk intussen in een andere categorie:</p>
        <ul class="chip-list">
          {andere.map((c) => (
            <li><a href={`${base}categorie/${c.slug}/`}><Icon name={c.slug} />{c.label}</a></li>
          ))}
        </ul>
      </div>
    ) : (
      <>
        <div class="section-head">
          <h2>{artikelen.length} artikel{artikelen.length === 1 ? '' : 'en'}</h2>
        </div>
        <div class="card-grid card-grid--wide">
          {artikelen.map((a) => <ArticleCard artikel={a} toonCategorie={false} />)}
        </div>
        <section class="related" aria-labelledby="andere-cat">
          <h2 id="andere-cat" style="font-size: 1.2rem">Andere categorieën</h2>
          <ul class="chip-list" style="justify-content: flex-start">
            {andere.map((c) => (
              <li><a href={`${base}categorie/${c.slug}/`}><Icon name={c.slug} />{c.label}</a></li>
            ))}
          </ul>
        </section>
      </>
    )}
  </div>
</Base>
