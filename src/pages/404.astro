---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { categorieen } from '../data/categorieen';
const base = import.meta.env.BASE_URL;
---
<Base title="Pagina niet gevonden" noindex>
  <div class="container section">
    <div class="empty-state">
      <h1>Deze pagina bestaat niet (meer)</h1>
      <p>Misschien is de link verouderd. Ga terug naar de <a href={base}>homepage</a> of kies een categorie:</p>
      <ul class="chip-list">
        {categorieen.map((c) => (
          <li><a href={`${base}categorie/${c.slug}/`}><Icon name={c.slug} />{c.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</Base>
